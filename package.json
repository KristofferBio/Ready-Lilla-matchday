{
  "name": "kampstotte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
